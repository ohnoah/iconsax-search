{
  "name": "iconsax-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, version-aware explorer for Iconsax React icons.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:check && tsc -b && vite build",
    "preview": "vite preview",
    "catalog:generate": "node scripts/generate-icon-catalog.mjs",
    "catalog:check": "node scripts/generate-icon-catalog.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.9",
    "iconsax-react": "0.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
